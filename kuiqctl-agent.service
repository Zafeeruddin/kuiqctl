[Unit]
Description=kuiqctl stable-address and network agent
Documentation=https://kubernetes.io/docs/setup/production-environment/tools/kubeadm/
After=network-online.target
Before=kubelet.service
Wants=network-online.target
ConditionPathExists=/etc/kubernetes/admin.conf

[Service]
Type=simple
ExecStartPre=/sbin/swapoff -a
ExecStartPre=/usr/local/bin/kuiqctl agent --once
ExecStart=/usr/local/bin/kuiqctl agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
