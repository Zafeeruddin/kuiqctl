#!/usr/bin/env python3
"""Simple, persistent single-node kubeadm cluster lifecycle manager."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import ipaddress
import json
import os
import pathlib
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request

CONFIG_PATH = pathlib.Path("/etc/kuiqctl/config.json")
ADMIN_CONF = pathlib.Path("/etc/kubernetes/admin.conf")
KUBEADM_CONFIG = pathlib.Path("/etc/kubernetes/kuiqctl-kubeadm.yaml")
LOCK_PATH = pathlib.Path("/run/lock/kuiqctl.lock")
IP_STATE_PATH = pathlib.Path("/run/kuiqctl/primary-ip")
CRI_SOCKET = "unix:///run/containerd/containerd.sock"
KUBERNETES_KEY_URL = "https://pkgs.k8s.io/core:/stable:/v{minor}/deb/Release.key"
KUBERNETES_REPO = "https://pkgs.k8s.io/core:/stable:/v{minor}/deb/"


def defaults() -> dict:
    return {
        "cluster_name": "quick-prod",
        "endpoint": "",
        "kubernetes_minor": "1.37",
        "calico_version": "v3.32.1",
        "pod_cidr": "10.244.0.0/16",
        "service_cidr": "10.96.0.0/12",
        "stable_node_ip": "10.255.255.1",
        "allowed_client_cidrs": ["192.168.0.0/24", "192.168.1.0/24"],
        "network_poll_seconds": 15,
    }


class KuiqctlError(RuntimeError):
    pass


def run(cmd: list[str], *, check: bool = True, capture: bool = False, env=None):
    return subprocess.run(
        cmd,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
        env=env,
    )


def require_root() -> None:
    if os.geteuid() != 0:
        raise KuiqctlError("this command changes host services; run it with sudo")


def load_config(path: pathlib.Path) -> dict:
    cfg = defaults()
    if path.exists():
        try:
            supplied = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise KuiqctlError(f"cannot read configuration {path}: {exc}") from exc
        if not isinstance(supplied, dict):
            raise KuiqctlError("configuration root must be a JSON object")
        unknown = sorted(set(supplied) - set(cfg))
        if unknown:
            raise KuiqctlError(f"unknown configuration keys: {', '.join(unknown)}")
        cfg.update(supplied)
    if not cfg["endpoint"]:
        cfg["endpoint"] = f"{socket.gethostname().split('.')[0]}.local"
    validate_config(cfg)
    return cfg


def valid_dns_or_ipv4(value: object) -> bool:
    if not isinstance(value, str) or not value:
        return False
    try:
        return ipaddress.ip_address(value).version == 4
    except ValueError:
        return len(value) <= 253 and all(
            re.fullmatch(r"[A-Za-z0-9](?:[-A-Za-z0-9]{0,61}[A-Za-z0-9])?", label)
            for label in value.rstrip(".").split(".")
        )


def validate_config(cfg: dict) -> None:
    cluster_name = cfg["cluster_name"]
    if not isinstance(cluster_name, str) or not re.fullmatch(
        r"[a-z0-9](?:[-a-z0-9.]{0,61}[a-z0-9])?", cluster_name
    ):
        raise KuiqctlError("cluster_name must be a lowercase Kubernetes label (maximum 63 chars)")
    if not valid_dns_or_ipv4(cfg["endpoint"]):
        raise KuiqctlError("endpoint must be one valid DNS name or IPv4 address")
    if not isinstance(cfg["kubernetes_minor"], str) or not re.fullmatch(
        r"1\.(?:3[1-9]|[4-9][0-9])", cfg["kubernetes_minor"]
    ):
        raise KuiqctlError("kubernetes_minor must be 1.31 or newer, for example 1.37")
    if not isinstance(cfg["calico_version"], str) or not re.fullmatch(
        r"v[0-9]+\.[0-9]+\.[0-9]+", cfg["calico_version"]
    ):
        raise KuiqctlError("calico_version must look like v3.32.1")
    if not isinstance(cfg["allowed_client_cidrs"], list):
        raise KuiqctlError("allowed_client_cidrs must be a JSON list")
    try:
        pod = ipaddress.ip_network(cfg["pod_cidr"])
        service = ipaddress.ip_network(cfg["service_cidr"])
        stable = ipaddress.ip_network(f"{cfg['stable_node_ip']}/32")
        clients = [ipaddress.ip_network(item) for item in cfg["allowed_client_cidrs"]]
    except (ValueError, TypeError) as exc:
        raise KuiqctlError(f"invalid IPv4/CIDR configuration: {exc}") from exc
    networks = [("pod_cidr", pod), ("service_cidr", service), ("stable_node_ip", stable)] + [
        (f"allowed_client_cidrs[{i}]", item) for i, item in enumerate(clients)
    ]
    if any(network.version != 4 for _, network in networks):
        raise KuiqctlError("only IPv4 networks are currently supported")
    if not ipaddress.ip_address(cfg["stable_node_ip"]).is_private:
        raise KuiqctlError("stable_node_ip must be an unused private IPv4 address")
    for index, (left_name, left) in enumerate(networks):
        for right_name, right in networks[index + 1 :]:
            if left.overlaps(right):
                raise KuiqctlError(f"{left_name} {left} overlaps {right_name} {right}")
    poll = cfg["network_poll_seconds"]
    if isinstance(poll, bool) or not isinstance(poll, int) or poll < 5:
        raise KuiqctlError("network_poll_seconds must be an integer of at least 5")


@contextlib.contextmanager
def lifecycle_lock():
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise KuiqctlError("another cluster lifecycle operation is already running") from exc
        yield


def service_active(name: str) -> bool:
    result = run(["systemctl", "is-active", "--quiet", name], check=False, capture=True)
    return result.returncode == 0


def path_exists(path: pathlib.Path) -> bool:
    try:
        return path.exists()
    except PermissionError:
        return False


def cluster_present() -> bool:
    return any(
        path_exists(path)
        for path in [
            ADMIN_CONF,
            pathlib.Path("/etc/kubernetes/manifests/kube-apiserver.yaml"),
            pathlib.Path("/etc/kubernetes/pki/ca.crt"),
            pathlib.Path("/var/lib/etcd/member"),
        ]
    )


def legacy_k3s_present() -> bool:
    return path_exists(pathlib.Path("/etc/rancher/k3s/k3s.yaml"))


def download(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "kuiqctl/1"})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.read()
    except OSError as exc:
        raise KuiqctlError(f"could not download {url}: {exc}") from exc


def install_repository(cfg: dict) -> None:
    minor = cfg["kubernetes_minor"]
    key_data = download(KUBERNETES_KEY_URL.format(minor=minor))
    pathlib.Path("/etc/apt/keyrings").mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix="kubernetes-release-key-", delete=False) as handle:
        handle.write(key_data)
        source = pathlib.Path(handle.name)
    try:
        run(["gpg", "--dearmor", "--yes", "--output", "/etc/apt/keyrings/kubernetes-apt-keyring.gpg", str(source)])
    finally:
        source.unlink(missing_ok=True)
    repo = f"deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] {KUBERNETES_REPO.format(minor=minor)} /\n"
    pathlib.Path("/etc/apt/sources.list.d/kubernetes.list").write_text(repo)


def configure_containerd() -> None:
    config_path = pathlib.Path("/etc/containerd/config.toml")
    config_path.parent.mkdir(parents=True, exist_ok=True)
    generated = run(["containerd", "config", "default"], capture=True).stdout
    generated = re.sub(r"SystemdCgroup\s*=\s*false", "SystemdCgroup = true", generated)
    if "SystemdCgroup = true" not in generated:
        raise KuiqctlError("could not enable containerd's systemd cgroup driver")
    backup = config_path.with_name("config.toml.before-kuiqctl")
    if config_path.exists() and not backup.exists():
        shutil.copy2(config_path, backup)
    temporary = config_path.with_suffix(".tmp")
    temporary.write_text(generated)
    os.chmod(temporary, 0o644)
    temporary.replace(config_path)
    run(["systemctl", "enable", "--now", "containerd"])
    run(["systemctl", "restart", "containerd"])


def ensure_endpoint(cfg: dict) -> None:
    endpoint = cfg["endpoint"]
    if not endpoint.lower().endswith(".local"):
        return
    expected = f"{socket.gethostname().split('.')[0]}.local"
    if endpoint.lower() != expected.lower():
        raise KuiqctlError(f"mDNS endpoint must match this host ({expected}); use external DNS for aliases")
    if not shutil.which("avahi-daemon"):
        raise KuiqctlError("avahi-daemon is required for a .local roaming endpoint")
    run(["systemctl", "enable", "--now", "avahi-daemon"])


def ensure_stable_ip(cfg: dict) -> None:
    run(["ip", "address", "replace", f"{cfg['stable_node_ip']}/32", "dev", "lo"])


def package_stack_ready(cfg: dict) -> bool:
    required = ["kubeadm", "kubelet", "kubectl", "containerd", "avahi-daemon"]
    if any(not shutil.which(binary) for binary in required):
        return False
    version = run(["kubeadm", "version", "-o", "short"], check=False, capture=True)
    return version.returncode == 0 and version.stdout.startswith(f"v{cfg['kubernetes_minor']}.")


def prerequisite_packages() -> list[str]:
    packages = ["ca-certificates", "curl", "gpg", "avahi-daemon"]
    # Docker's containerd.io provides the same binary and conflicts with
    # Ubuntu's containerd package. Reuse whichever containerd is installed.
    if not shutil.which("containerd"):
        packages.append("containerd")
    return packages


def prepare_host(cfg: dict) -> None:
    if not shutil.which("apt-get"):
        raise KuiqctlError("this release supports Debian/Ubuntu hosts with apt-get")
    if not package_stack_ready(cfg):
        run(["apt-get", "update"])
        run(["apt-get", "install", "-y", *prerequisite_packages()])
        install_repository(cfg)
        run(["apt-get", "update"])
        run(["apt-mark", "unhold", "kubelet", "kubeadm", "kubectl"], check=False)
        run(["apt-get", "install", "-y", "kubelet", "kubeadm", "kubectl"])
        run(["apt-mark", "hold", "kubelet", "kubeadm", "kubectl"])
    pathlib.Path("/etc/modules-load.d/kuiqctl.conf").write_text("overlay\nbr_netfilter\n")
    pathlib.Path("/etc/sysctl.d/99-kuiqctl.conf").write_text(
        "net.bridge.bridge-nf-call-iptables = 1\n"
        "net.bridge.bridge-nf-call-ip6tables = 1\n"
        "net.ipv4.ip_forward = 1\n"
    )
    run(["modprobe", "overlay"])
    run(["modprobe", "br_netfilter"])
    run(["sysctl", "--system"])
    run(["swapoff", "-a"])
    configure_containerd()
    ensure_endpoint(cfg)
    ensure_stable_ip(cfg)
    run(["systemctl", "enable", "--now", "kubelet"])


def configure_firewall(cfg: dict) -> None:
    if not shutil.which("ufw"):
        return
    status = run(["ufw", "status"], check=False, capture=True)
    if "Status: active" not in status.stdout:
        return
    for cidr in cfg["allowed_client_cidrs"]:
        run(["ufw", "allow", "from", cidr, "to", "any", "port", "6443", "proto", "tcp", "comment", "kuiqctl API"])


def yaml_string(value: str) -> str:
    return json.dumps(value)


def write_kubeadm_config(cfg: dict) -> None:
    KUBEADM_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    node_name = socket.gethostname().split(".")[0].lower()
    content = f"""# Managed by kuiqctl. Edit {CONFIG_PATH} instead.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {yaml_string(cfg['stable_node_ip'])}
  bindPort: 6443
nodeRegistration:
  name: {yaml_string(node_name)}
  criSocket: {yaml_string(CRI_SOCKET)}
  taints: []
  kubeletExtraArgs:
    - name: node-ip
      value: {yaml_string(cfg['stable_node_ip'])}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {yaml_string(cfg['cluster_name'])}
controlPlaneEndpoint: {yaml_string(cfg['stable_node_ip'] + ':6443')}
kubernetesVersion: {yaml_string('stable-' + cfg['kubernetes_minor'])}
apiServer:
  certSANs:
    - {yaml_string(cfg['endpoint'])}
    - {yaml_string(cfg['stable_node_ip'])}
networking:
  podSubnet: {yaml_string(cfg['pod_cidr'])}
  serviceSubnet: {yaml_string(cfg['service_cidr'])}
  dnsDomain: cluster.local
"""
    temporary = KUBEADM_CONFIG.with_suffix(".tmp")
    temporary.write_text(content)
    os.chmod(temporary, 0o600)
    temporary.replace(KUBEADM_CONFIG)


def kubectl(args: list[str], *, check: bool = True, capture: bool = False):
    return run(["kubectl", "--kubeconfig", str(ADMIN_CONF), *args], check=check, capture=capture)


def install_calico(cfg: dict) -> None:
    url = f"https://raw.githubusercontent.com/projectcalico/calico/{cfg['calico_version']}/manifests/calico.yaml"
    kubectl(["apply", "-f", url])
    # Keep Calico independent of whichever DHCP address the LAN currently uses.
    kubectl(
        [
            "-n",
            "kube-system",
            "set",
            "env",
            "daemonset/calico-node",
            "IP_AUTODETECTION_METHOD=kubernetes-internal-ip",
        ]
    )


def wait_ready(timeout: int = 300) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        api = kubectl(["get", "--raw=/readyz"], check=False, capture=True)
        nodes = kubectl(["get", "nodes", "-o", "jsonpath={.items[0].status.conditions[?(@.type=='Ready')].status}"], check=False, capture=True)
        if api.returncode == 0 and api.stdout.strip() == "ok" and nodes.returncode == 0 and nodes.stdout.strip() == "True":
            return
        time.sleep(5)
    raise KuiqctlError("Kubernetes API and node did not become ready within 300 seconds")


def enable_agent() -> None:
    unit = pathlib.Path("/etc/systemd/system/kuiqctl-agent.service")
    if not unit.exists():
        raise KuiqctlError("agent unit is missing; run the repository install.sh first")
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "kuiqctl-agent.service"])


def create(cfg: dict) -> None:
    require_root()
    with lifecycle_lock():
        if legacy_k3s_present():
            raise KuiqctlError("K3s is installed; run 'kuiqctl recreate --yes' to replace it with kubeadm")
        if cluster_present():
            raise KuiqctlError("a kubeadm cluster already exists; use 'kuiqctl recreate --yes'")
        if not pathlib.Path("/run/systemd/system").exists():
            raise KuiqctlError("systemd is required")
        prepare_host(cfg)
        configure_firewall(cfg)
        write_kubeadm_config(cfg)
        print(f"Creating kubeadm cluster {cfg['cluster_name']} with Kubernetes {cfg['kubernetes_minor']}...")
        run(["kubeadm", "config", "validate", "--config", str(KUBEADM_CONFIG)])
        run(["kubeadm", "init", "--config", str(KUBEADM_CONFIG)])
        install_calico(cfg)
        wait_ready()
        enable_agent()
        print(f"Cluster is ready at https://{cfg['endpoint']}:6443")
        print("Export its kubeconfig with: sudo kuiqctl kubeconfig --output ~/.kube/quick-prod.yaml")


def reset_cluster(cfg: dict, *, remove_alias: bool) -> None:
    run(["systemctl", "disable", "--now", "kuiqctl-agent.service"], check=False)
    if legacy_k3s_present():
        legacy_uninstaller = pathlib.Path("/usr/local/bin/k3s-uninstall.sh")
        if not legacy_uninstaller.exists():
            raise KuiqctlError("legacy K3s state exists but k3s-uninstall.sh is missing")
        run([str(legacy_uninstaller)])
    if shutil.which("kubeadm") and cluster_present():
        run(["kubeadm", "reset", "--force", "--cri-socket", CRI_SOCKET])
    for path in [pathlib.Path("/etc/cni/net.d/10-calico.conflist"), pathlib.Path("/etc/cni/net.d/calico-kubeconfig")]:
        path.unlink(missing_ok=True)
    for interface in ["cni0", "tunl0", "vxlan.calico"]:
        run(["ip", "link", "delete", interface], check=False, capture=True)
    if remove_alias:
        run(["ip", "address", "delete", f"{cfg['stable_node_ip']}/32", "dev", "lo"], check=False, capture=True)
        run(["systemctl", "disable", "--now", "kubelet"], check=False)


def remove(cfg: dict, yes: bool) -> None:
    require_root()
    if not yes:
        raise KuiqctlError("remove destroys workloads and cluster data; repeat with --yes")
    with lifecycle_lock():
        reset_cluster(cfg, remove_alias=True)
        print("Cluster and kubeadm state removed; packages and kuiqctl configuration were preserved.")


def recreate(cfg: dict, yes: bool) -> None:
    require_root()
    if not yes:
        raise KuiqctlError("recreate destroys workloads and cluster data; repeat with --yes")
    # Resolve repositories, packages and runtime configuration before deleting
    # a working cluster. A dependency/download failure must not erase it first.
    prepare_host(cfg)
    with lifecycle_lock():
        reset_cluster(cfg, remove_alias=False)
    create(cfg)


def rewrite_kubeconfig(text: str, endpoint: str, cluster_name: str) -> str:
    text = re.sub(r"https://[^:\s]+:6443", f"https://{endpoint}:6443", text, count=1)
    text = re.sub(
        r"(?m)^(\s*(?:name|cluster|user|current-context):\s*)kubernetes(?:-admin)?(\s*)$",
        rf"\g<1>{cluster_name}\g<2>",
        text,
    )
    return text


def kubeconfig(cfg: dict, output: str | None) -> None:
    require_root()
    if not ADMIN_CONF.exists():
        raise KuiqctlError("cluster kubeconfig does not exist; create the cluster first")
    content = rewrite_kubeconfig(ADMIN_CONF.read_text(), cfg["endpoint"], cfg["cluster_name"])
    if not output or output == "-":
        sys.stdout.write(content)
        return
    destination = pathlib.Path(output).expanduser()
    parent_existed = destination.parent.exists()
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_suffix(destination.suffix + ".tmp")
    temporary.write_text(content)
    os.chmod(temporary, 0o600)
    temporary.replace(destination)
    sudo_uid, sudo_gid = os.environ.get("SUDO_UID"), os.environ.get("SUDO_GID")
    if sudo_uid and sudo_gid:
        os.chown(destination, int(sudo_uid), int(sudo_gid))
        if not parent_existed:
            os.chown(destination.parent, int(sudo_uid), int(sudo_gid))
    print(f"Wrote {destination}")


def primary_ip() -> str:
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.connect(("1.1.1.1", 53))
        return sock.getsockname()[0]
    except OSError:
        return ""
    finally:
        if "sock" in locals():
            sock.close()


def status(cfg: dict) -> int:
    kubelet = service_active("kubelet")
    watcher = service_active("kuiqctl-agent.service")
    legacy = legacy_k3s_present()
    print(f"cluster:  {cfg['cluster_name']}")
    print("backend:  kubeadm")
    print(f"kubelet:  {'running' if kubelet else 'stopped'}")
    print(f"watcher:  {'running' if watcher else 'stopped'}")
    print(f"endpoint: https://{cfg['endpoint']}:6443")
    print(f"host-ip:  {primary_ip() or 'unavailable'}")
    print(f"node-ip:  {cfg['stable_node_ip']} (host-only, stable)")
    if legacy:
        print("legacy:   K3s state detected; use kuiqctl recreate --yes to migrate")
    if path_exists(ADMIN_CONF) and os.geteuid() == 0:
        return kubectl(["get", "nodes", "-o", "wide"], check=False).returncode
    return 1 if cluster_present() or legacy else 0


def agent(cfg: dict, once: bool) -> None:
    require_root()
    IP_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    previous = IP_STATE_PATH.read_text().strip() if IP_STATE_PATH.exists() else ""
    while True:
        run(["swapoff", "-a"])
        ensure_stable_ip(cfg)
        current = primary_ip()
        if current and current != previous:
            IP_STATE_PATH.write_text(current + "\n")
            print(f"primary LAN IP is now {current}; stable kubeadm node IP remains {cfg['stable_node_ip']}", flush=True)
            previous = current
        if once:
            return
        time.sleep(cfg["network_poll_seconds"])


def init_config(path: pathlib.Path) -> None:
    require_root()
    if path.exists():
        raise KuiqctlError(f"refusing to overwrite existing {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(defaults(), indent=2) + "\n")
    os.chmod(path, 0o644)
    print(f"Created {path}; endpoint defaults to this-hostname.local when left empty.")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="kuiqctl", description=__doc__)
    root.add_argument("--config", type=pathlib.Path, default=CONFIG_PATH)
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("create", help="create and start a kubeadm cluster")
    destructive = commands.add_parser("recreate", help="destroy and create the cluster")
    destructive.add_argument("--yes", action="store_true")
    delete = commands.add_parser("remove", help="destroy and remove the cluster")
    delete.add_argument("--yes", action="store_true")
    commands.add_parser("status", help="show cluster and network status")
    export = commands.add_parser("kubeconfig", help="export a roaming kubeconfig")
    export.add_argument("--output", "-o")
    internal = commands.add_parser("agent", help=argparse.SUPPRESS)
    internal.add_argument("--once", action="store_true", help=argparse.SUPPRESS)
    commands.add_parser("init", help="create a default configuration")
    return root


def main(argv=None) -> int:
    args = parser().parse_args(argv)
    try:
        if args.command in {"create", "recreate", "remove", "kubeconfig", "agent", "init"}:
            require_root()
        if args.command == "init":
            init_config(args.config)
            return 0
        cfg = load_config(args.config)
        if args.command == "create":
            create(cfg)
        elif args.command == "recreate":
            recreate(cfg, args.yes)
        elif args.command == "remove":
            remove(cfg, args.yes)
        elif args.command == "status":
            return status(cfg)
        elif args.command == "kubeconfig":
            kubeconfig(cfg, args.output)
        elif args.command == "agent":
            agent(cfg, args.once)
        return 0
    except KuiqctlError as exc:
        print(f"kuiqctl: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        print(f"kuiqctl: command failed ({exc.returncode}): {' '.join(exc.cmd)}", file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
