__version__ = "0.1.1-dev"

CONFIG_PATH = pathlib.Path("/etc/kuiqctl/config.json")
ADMIN_CONF = pathlib.Path("/etc/kubernetes/admin.conf")
KUBEADM_CONFIG = pathlib.Path("/etc/kubernetes/kuiqctl-kubeadm.yaml")
LOCK_PATH = pathlib.Path("/run/lock/kuiqctl.lock")
IP_STATE_PATH = pathlib.Path("/run/kuiqctl/primary-ip")
CACHE_DIR = pathlib.Path("/var/cache/kuiqctl")
CALICO_MANIFEST = CACHE_DIR / "calico.yaml"
CRI_SOCKET = "unix:///run/containerd/containerd.sock"
CONTROL_PLANE_PORTS = (6443, 10257, 10259, 2379, 2380)
CONTROL_PLANE_PROCESSES = {
    6443: "kube-apiserver",
    10257: "kube-controller-manager",
    10259: "kube-scheduler",
    2379: "etcd",
    2380: "etcd",
}
KUBERNETES_KEY_URL = "https://pkgs.k8s.io/core:/stable:/v{minor}/deb/Release.key"
KUBERNETES_REPO = "https://pkgs.k8s.io/core:/stable:/v{minor}/deb/"
KUBERNETES_PACKAGES = ("kubelet", "kubeadm", "kubectl", "cri-tools")


def defaults() -> dict:
    return {
        "cluster_name": "kuiqctl",
        "endpoint": "",
        "kubernetes_minor": "1.37",
        "calico_version": "v3.32.1",
        "image_repository": "registry.k8s.io",
        "pod_cidr": "10.244.0.0/16",
        "service_cidr": "10.96.0.0/12",
        "stable_node_ip": "10.255.255.1",
        "allowed_client_cidrs": ["192.168.0.0/24", "192.168.1.0/24"],
        "network_poll_seconds": 15,
    }


class KuiqctlError(RuntimeError):
    pass


def run(
    cmd: list[str],
    *,
    check: bool = True,
    capture: bool = False,
    env=None,
    timeout: int | None = None,
):
    try:
        return subprocess.run(
            cmd,
            check=check,
            text=True,
            stdout=subprocess.PIPE if capture else None,
            stderr=subprocess.PIPE if capture else None,
            env=env,
            timeout=timeout,
        )
    except FileNotFoundError as exc:
        raise KuiqctlError(f"required command not found: {cmd[0]}") from exc


def require_root() -> None:
    if os.geteuid() != 0:
        raise KuiqctlError("this command changes host services; run it with sudo")


def load_config(path: pathlib.Path) -> dict:
    cfg = defaults()
    if path.exists():
        try:
            supplied = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            raise KuiqctlError(f"cannot read configuration {path}: {exc}") from exc
        if not isinstance(supplied, dict):
            raise KuiqctlError("configuration root must be a JSON object")
        unknown = sorted(set(supplied) - set(cfg))
        if unknown:
            raise KuiqctlError(f"unknown configuration keys: {', '.join(unknown)}")
        cfg.update(supplied)
    if not cfg["endpoint"]:
        cfg["endpoint"] = f"{socket.gethostname().split('.')[0]}.local"
    validate_config(cfg)
    return cfg


def valid_dns_or_ipv4(value: object) -> bool:
    if not isinstance(value, str) or not value:
        return False
    try:
        return ipaddress.ip_address(value).version == 4
    except ValueError:
        return len(value) <= 253 and all(
            re.fullmatch(r"[A-Za-z0-9](?:[-A-Za-z0-9]{0,61}[A-Za-z0-9])?", label)
            for label in value.rstrip(".").split(".")
        )


def validate_config(cfg: dict) -> None:
    cluster_name = cfg["cluster_name"]
    if not isinstance(cluster_name, str) or not re.fullmatch(
        r"[a-z0-9](?:[-a-z0-9.]{0,61}[a-z0-9])?", cluster_name
    ):
        raise KuiqctlError("cluster_name must be a lowercase Kubernetes label (maximum 63 chars)")
    if not valid_dns_or_ipv4(cfg["endpoint"]):
        raise KuiqctlError("endpoint must be one valid DNS name or IPv4 address")
    if not isinstance(cfg["kubernetes_minor"], str) or not re.fullmatch(
        r"1\.(?:3[1-9]|[4-9][0-9])", cfg["kubernetes_minor"]
    ):
        raise KuiqctlError("kubernetes_minor must be 1.31 or newer, for example 1.37")
    if not isinstance(cfg["calico_version"], str) or not re.fullmatch(
        r"v[0-9]+\.[0-9]+\.[0-9]+", cfg["calico_version"]
    ):
        raise KuiqctlError("calico_version must look like v3.32.1")
    repository = cfg["image_repository"]
    if (
        not isinstance(repository, str)
        or not repository.strip()
        or "://" in repository
        or any(character.isspace() for character in repository)
    ):
        raise KuiqctlError("image_repository must be a registry host/path without a URL scheme")
    if not isinstance(cfg["allowed_client_cidrs"], list):
        raise KuiqctlError("allowed_client_cidrs must be a JSON list")
    try:
        pod = ipaddress.ip_network(cfg["pod_cidr"])
        service = ipaddress.ip_network(cfg["service_cidr"])
        stable = ipaddress.ip_network(f"{cfg['stable_node_ip']}/32")
        clients = [ipaddress.ip_network(item) for item in cfg["allowed_client_cidrs"]]
    except (ValueError, TypeError) as exc:
        raise KuiqctlError(f"invalid IPv4/CIDR configuration: {exc}") from exc
    networks = [("pod_cidr", pod), ("service_cidr", service), ("stable_node_ip", stable)] + [
        (f"allowed_client_cidrs[{i}]", item) for i, item in enumerate(clients)
    ]
    if any(network.version != 4 for _, network in networks):
        raise KuiqctlError("only IPv4 networks are currently supported")
    if not ipaddress.ip_address(cfg["stable_node_ip"]).is_private:
        raise KuiqctlError("stable_node_ip must be an unused private IPv4 address")
    for index, (left_name, left) in enumerate(networks):
        for right_name, right in networks[index + 1 :]:
            if left.overlaps(right):
                raise KuiqctlError(f"{left_name} {left} overlaps {right_name} {right}")
    poll = cfg["network_poll_seconds"]
    if isinstance(poll, bool) or not isinstance(poll, int) or poll < 5:
        raise KuiqctlError("network_poll_seconds must be an integer of at least 5")


@contextlib.contextmanager
def lifecycle_lock():
    LOCK_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("w") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            raise KuiqctlError("another cluster lifecycle operation is already running") from exc
        yield


def service_active(name: str) -> bool:
    result = run(["systemctl", "is-active", "--quiet", name], check=False, capture=True)
    return result.returncode == 0


def path_exists(path: pathlib.Path) -> bool:
    try:
        return path.exists()
    except PermissionError:
        return False


def cluster_present() -> bool:
    return any(
        path_exists(path)
        for path in [
            ADMIN_CONF,
            pathlib.Path("/etc/kubernetes/manifests/kube-apiserver.yaml"),
            pathlib.Path("/etc/kubernetes/pki/ca.crt"),
            pathlib.Path("/var/lib/etcd/member"),
        ]
    )


def legacy_k3s_present() -> bool:
    return path_exists(pathlib.Path("/etc/rancher/k3s/k3s.yaml"))


def occupied_control_plane_ports() -> list[int]:
    occupied = []
    for port in CONTROL_PLANE_PORTS:
        probe = None
        try:
            probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            probe.bind(("0.0.0.0", port))
        except OSError as exc:
            if exc.errno == errno.EADDRINUSE:
                occupied.append(port)
            elif exc.errno not in {errno.EACCES, errno.EPERM}:
                raise KuiqctlError(f"could not probe control-plane port {port}: {exc}") from exc
        finally:
            if probe is not None:
                probe.close()
    return occupied


def clean_host_preflight() -> None:
    ports = occupied_control_plane_ports()
    reasons = []
    if legacy_k3s_present():
        reasons.append("legacy K3s state exists")
    if cluster_present():
        reasons.append("kubeadm state exists")
    if ports:
        reasons.append(f"control-plane ports are occupied: {', '.join(map(str, ports))}")
    if reasons:
        raise KuiqctlError(
            "cannot create on this host because "
            + "; ".join(reasons)
            + ". Run 'sudo kuiqctl recreate --yes' to clean and rebuild it"
        )


def wait_for_control_plane_ports(timeout: int = 30) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        ports = occupied_control_plane_ports()
        if not ports:
            return
        time.sleep(1)
    raise KuiqctlError(
        "recreate cleanup could not release control-plane ports "
        + ", ".join(map(str, occupied_control_plane_ports()))
        + "; inspect them with: sudo ss -ltnp"
    )


def port_owner_pids(port: int) -> set[int]:
    result = run(
        ["ss", "-H", "-ltnp", "sport", "=", f":{port}"],
        check=False,
        capture=True,
    )
    if result.returncode != 0:
        return set()
    return {int(value) for value in re.findall(r"\bpid=(\d+)", result.stdout)}


def process_matches(pid: int, expected: str) -> bool:
    candidates = set()
    try:
        command = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0", 1)[0]
        if command:
            candidates.add(pathlib.Path(os.fsdecode(command)).name)
    except OSError:
        pass
    try:
        candidates.add(pathlib.Path(os.readlink(f"/proc/{pid}/exe")).name.removesuffix(" (deleted)"))
    except OSError:
        pass
    return expected in candidates


def stop_stale_control_plane_processes(timeout: int = 5) -> None:
    targets = {}
    for port, expected in CONTROL_PLANE_PROCESSES.items():
        for pid in port_owner_pids(port):
            if process_matches(pid, expected):
                targets[pid] = expected
                print(f"Stopping stale {expected} process {pid} on port {port}...")
                try:
                    os.kill(pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
    if not targets:
        return
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not any(process_matches(pid, expected) for pid, expected in targets.items()):
            return
        time.sleep(0.2)
    for pid, expected in targets.items():
        if process_matches(pid, expected):
            print(f"Force-stopping stale {expected} process {pid}...")
            try:
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass


def available_cri_sockets() -> list[str]:
    candidates = [
        "/var/run/crio/crio.sock",
        "/run/crio/crio.sock",
        "/run/containerd/containerd.sock",
    ]
    sockets = []
    for candidate in candidates:
        resolved = str(pathlib.Path(candidate).resolve(strict=False))
        value = f"unix://{resolved}"
        if path_exists(pathlib.Path(candidate)) and value not in sockets:
            sockets.append(value)
    return sockets or [CRI_SOCKET]


def crictl_command(cri_socket: str, *args: str) -> list[str]:
    return [
        "crictl",
        "--runtime-endpoint",
        cri_socket,
        "--image-endpoint",
        cri_socket,
        *args,
    ]


def remove_remaining_cri_workloads(cri_socket: str) -> None:
    # kubeadm reset is best-effort. Force-remove only workloads exposed by
    # this CRI endpoint if static control-plane containers survived it.
    run(
        crictl_command(cri_socket, "rm", "--force", "--all"),
        check=False,
        capture=True,
    )
    run(
        crictl_command(cri_socket, "rmp", "--force", "--all"),
        check=False,
        capture=True,
    )


def download(url: str) -> bytes:
    request = urllib.request.Request(url, headers={"User-Agent": "kuiqctl/1"})
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.read()
    except OSError as exc:
        raise KuiqctlError(f"could not download {url}: {exc}") from exc


def install_repository(cfg: dict) -> None:
    minor = cfg["kubernetes_minor"]
    key_data = download(KUBERNETES_KEY_URL.format(minor=minor))
    pathlib.Path("/etc/apt/keyrings").mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(prefix="kubernetes-release-key-", delete=False) as handle:
        handle.write(key_data)
        source = pathlib.Path(handle.name)
    try:
        run(["gpg", "--dearmor", "--yes", "--output", "/etc/apt/keyrings/kubernetes-apt-keyring.gpg", str(source)])
    finally:
        source.unlink(missing_ok=True)
    repo = f"deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] {KUBERNETES_REPO.format(minor=minor)} /\n"
    pathlib.Path("/etc/apt/sources.list.d/kubernetes.list").write_text(repo)


def configure_containerd() -> None:
    config_path = pathlib.Path("/etc/containerd/config.toml")
    config_path.parent.mkdir(parents=True, exist_ok=True)
    generated = run(["containerd", "config", "default"], capture=True).stdout
    generated = re.sub(r"SystemdCgroup\s*=\s*false", "SystemdCgroup = true", generated)
    if "SystemdCgroup = true" not in generated:
        raise KuiqctlError("could not enable containerd's systemd cgroup driver")
    backup = config_path.with_name("config.toml.before-kuiqctl")
    if config_path.exists() and not backup.exists():
        shutil.copy2(config_path, backup)
    temporary = config_path.with_suffix(".tmp")
    temporary.write_text(generated)
    os.chmod(temporary, 0o644)
    temporary.replace(config_path)
    run(["systemctl", "enable", "--now", "containerd"])
    run(["systemctl", "restart", "containerd"])


def ensure_endpoint(cfg: dict) -> None:
    endpoint = cfg["endpoint"]
    if not endpoint.lower().endswith(".local"):
        return
    expected = f"{socket.gethostname().split('.')[0]}.local"
    if endpoint.lower() != expected.lower():
        raise KuiqctlError(f"mDNS endpoint must match this host ({expected}); use external DNS for aliases")
    if not shutil.which("avahi-daemon"):
        raise KuiqctlError("avahi-daemon is required for a .local roaming endpoint")
    run(["systemctl", "enable", "--now", "avahi-daemon"])


def ensure_stable_ip(cfg: dict) -> None:
    run(["ip", "address", "replace", f"{cfg['stable_node_ip']}/32", "dev", "lo"])


def package_stack_ready(cfg: dict) -> bool:
    required = ["kubeadm", "kubelet", "kubectl", "crictl", "containerd", "avahi-daemon"]
    if any(not shutil.which(binary) for binary in required):
        return False
    version = run(["kubeadm", "version", "-o", "short"], check=False, capture=True)
    return version.returncode == 0 and version.stdout.startswith(f"v{cfg['kubernetes_minor']}.")


def installed_kubernetes_version() -> str:
    result = run(["kubeadm", "version", "-o", "short"], capture=True)
    version = result.stdout.strip()
    if not re.fullmatch(r"v[0-9]+\.[0-9]+\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?", version):
        raise KuiqctlError(f"kubeadm returned an invalid version: {version!r}")
    return version


def prerequisite_packages() -> list[str]:
    packages = ["ca-certificates", "curl", "gpg", "avahi-daemon"]
    # Docker's containerd.io provides the same binary and conflicts with
    # Ubuntu's containerd package. Reuse whichever containerd is installed.
    if not shutil.which("containerd"):
        packages.append("containerd")
    return packages


def prepare_host(cfg: dict) -> None:
    if not shutil.which("apt-get"):
        raise KuiqctlError("this release supports Debian/Ubuntu hosts with apt-get")
    if not package_stack_ready(cfg):
        run(["apt-get", "update"])
        run(["apt-get", "install", "-y", *prerequisite_packages()])
        install_repository(cfg)
        run(["apt-get", "update"])
        run(["apt-mark", "unhold", *KUBERNETES_PACKAGES], check=False)
        run(["apt-get", "install", "-y", *KUBERNETES_PACKAGES])
        run(["apt-mark", "hold", *KUBERNETES_PACKAGES])
    pathlib.Path("/etc/modules-load.d/kuiqctl.conf").write_text("overlay\nbr_netfilter\n")
    sysctl_path = pathlib.Path("/etc/sysctl.d/99-kuiqctl.conf")
    sysctl_path.write_text(
        "net.bridge.bridge-nf-call-iptables = 1\n"
        "net.bridge.bridge-nf-call-ip6tables = 1\n"
        "net.ipv4.ip_forward = 1\n"
    )
    run(["modprobe", "overlay"])
    run(["modprobe", "br_netfilter"])
    # Apply only the settings owned by kuiqctl. Replaying every host sysctl can
    # fail on unrelated stale keys and produces pages of irrelevant output.
    run(["sysctl", "--load", str(sysctl_path)])
    run(["swapoff", "-a"])
    configure_containerd()
    ensure_endpoint(cfg)
    ensure_stable_ip(cfg)
    run(["systemctl", "enable", "--now", "kubelet"])


def configure_firewall(cfg: dict) -> None:
    if not shutil.which("ufw"):
        return
    status = run(["ufw", "status"], check=False, capture=True)
    if "Status: active" not in status.stdout:
        return
    for cidr in cfg["allowed_client_cidrs"]:
        run(["ufw", "allow", "from", cidr, "to", "any", "port", "6443", "proto", "tcp", "comment", "kuiqctl API"])


def yaml_string(value: str) -> str:
    return json.dumps(value)


def write_kubeadm_config(cfg: dict) -> None:
    KUBEADM_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    node_name = socket.gethostname().split(".")[0].lower()
    kubernetes_version = installed_kubernetes_version()
    content = f"""# Managed by kuiqctl. Edit {CONFIG_PATH} instead.
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {yaml_string(cfg['stable_node_ip'])}
  bindPort: 6443
nodeRegistration:
  name: {yaml_string(node_name)}
  criSocket: {yaml_string(CRI_SOCKET)}
  taints: []
  kubeletExtraArgs:
    - name: node-ip
      value: {yaml_string(cfg['stable_node_ip'])}
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {yaml_string(cfg['cluster_name'])}
controlPlaneEndpoint: {yaml_string(cfg['stable_node_ip'] + ':6443')}
kubernetesVersion: {yaml_string(kubernetes_version)}
imageRepository: {yaml_string(cfg['image_repository'])}
apiServer:
  certSANs:
    - {yaml_string(cfg['endpoint'])}
    - {yaml_string(cfg['stable_node_ip'])}
networking:
  podSubnet: {yaml_string(cfg['pod_cidr'])}
  serviceSubnet: {yaml_string(cfg['service_cidr'])}
  dnsDomain: cluster.local
"""
    temporary = KUBEADM_CONFIG.with_suffix(".tmp")
    temporary.write_text(content)
    os.chmod(temporary, 0o600)
    temporary.replace(KUBEADM_CONFIG)


def kubectl(
    args: list[str],
    *,
    check: bool = True,
    capture: bool = False,
    timeout: int | None = None,
):
    return run(
        ["kubectl", "--kubeconfig", str(ADMIN_CONF), *args],
        check=check,
        capture=capture,
        timeout=timeout,
    )


def registry_hostname(repository: str) -> str:
    parsed = urllib.parse.urlparse("//" + repository)
    if not parsed.hostname:
        raise KuiqctlError(f"cannot determine a hostname from image_repository {repository!r}")
    return parsed.hostname


def configured_nameservers() -> str:
    try:
        values = [
            line.split()[1]
            for line in pathlib.Path("/etc/resolv.conf").read_text().splitlines()
            if line.strip().startswith("nameserver ") and len(line.split()) >= 2
        ]
    except OSError:
        values = []
    return ", ".join(values) or "unknown"


def resolve_required_hosts(cfg: dict) -> None:
    if not primary_ip():
        raise KuiqctlError(
            "network preflight failed: no usable default IPv4 route is available. "
            "Reconnect the LAN/VPN or repair the default route before retrying. "
            "No existing cluster state was reset"
        )
    hosts = [registry_hostname(cfg["image_repository"]), "raw.githubusercontent.com"]
    for host in hosts:
        try:
            socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)
        except OSError as exc:
            raise KuiqctlError(
                f"network preflight failed: DNS cannot resolve {host} using nameserver(s) "
                f"{configured_nameservers()}. Fix DNS/VPN/firewall connectivity, or configure "
                "a reachable image_repository. No existing cluster state was reset"
            ) from exc


def cache_calico_manifest(cfg: dict) -> None:
    url = f"https://raw.githubusercontent.com/projectcalico/calico/{cfg['calico_version']}/manifests/calico.yaml"
    try:
        data = download(url)
    except KuiqctlError as exc:
        raise KuiqctlError(
            f"artifact preflight could not cache Calico from {url}: {exc}. "
            "Check DNS, GitHub access, proxy/VPN policy, or preload the required artifacts. "
            "No existing cluster state was reset"
        ) from exc
    if len(data) < 1000 or b"calico-node" not in data or b"kind:" not in data:
        raise KuiqctlError(f"downloaded Calico manifest from {url} did not pass validation")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    temporary = CALICO_MANIFEST.with_suffix(".tmp")
    temporary.write_bytes(data)
    os.chmod(temporary, 0o644)
    temporary.replace(CALICO_MANIFEST)


def calico_images() -> list[str]:
    images = set()
    for line in CALICO_MANIFEST.read_text().splitlines():
        match = re.match(r"^\s*image:\s*[\"']?([^\s\"']+)", line)
        if match:
            images.add(match.group(1))
    if not images:
        raise KuiqctlError("cached Calico manifest contains no container images")
    return sorted(images)


def artifact_failure(stage: str, output: str) -> KuiqctlError:
    lowered = output.lower()
    if "network is unreachable" in lowered:
        hint = "the host has no usable route to its DNS server or registry"
    elif "no such host" in lowered or "lookup " in lowered or "name or service not known" in lowered:
        hint = f"DNS is failing; configured nameserver(s): {configured_nameservers()}"
    elif "timeout" in lowered or "deadline exceeded" in lowered:
        hint = "a firewall, proxy, VPN, or registry endpoint timed out"
    elif "unauthorized" in lowered or "denied" in lowered:
        hint = "the registry requires credentials or denied this image"
    else:
        hint = "check DNS, routing, proxy settings, registry credentials, and containerd logs"
    detail_lines = [line.strip() for line in output.splitlines() if line.strip()]
    detail = detail_lines[-1][:500] if detail_lines else "no command output"
    return KuiqctlError(
        f"artifact preflight failed while {stage}: {hint}. Last error: {detail}. "
        "No existing cluster state was reset"
    )


def pull_required_images() -> None:
    try:
        result = run(
            ["kubeadm", "config", "images", "pull", "--config", str(KUBEADM_CONFIG)],
            check=False,
            capture=True,
            timeout=600,
        )
    except subprocess.TimeoutExpired as exc:
        raise artifact_failure("pulling Kubernetes images", "image pull timed out") from exc
    if result.returncode != 0:
        raise artifact_failure("pulling Kubernetes images", result.stderr + "\n" + result.stdout)
    for image in calico_images():
        try:
            result = run(
                crictl_command(CRI_SOCKET, "pull", image),
                check=False,
                capture=True,
                timeout=600,
            )
        except subprocess.TimeoutExpired as exc:
            raise artifact_failure(f"pulling Calico image {image}", "image pull timed out") from exc
        if result.returncode != 0:
            raise artifact_failure(f"pulling Calico image {image}", result.stderr + "\n" + result.stdout)


def prepare_creation_artifacts(cfg: dict) -> None:
    print("Preflighting DNS, Kubernetes images, and Calico artifacts...")
    resolve_required_hosts(cfg)
    cache_calico_manifest(cfg)
    run(["kubeadm", "config", "validate", "--config", str(KUBEADM_CONFIG)])
    pull_required_images()
    print("Artifact preflight passed; all required manifests and images are available locally.")


def install_calico(cfg: dict) -> None:
    if not CALICO_MANIFEST.exists():
        raise KuiqctlError("cached Calico manifest is missing; artifact preflight was not completed")
    kubectl(["apply", "-f", str(CALICO_MANIFEST)])
    # Keep Calico independent of whichever DHCP address the LAN currently uses.
    kubectl(
        [
            "-n",
            "kube-system",
            "set",
            "env",
            "daemonset/calico-node",
            "IP_AUTODETECTION_METHOD=kubernetes-internal-ip",
        ]
    )


def wait_ready(timeout: int = 300) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        api = kubectl(["get", "--raw=/readyz"], check=False, capture=True)
        nodes = kubectl(["get", "nodes", "-o", "jsonpath={.items[0].status.conditions[?(@.type=='Ready')].status}"], check=False, capture=True)
        if api.returncode == 0 and api.stdout.strip() == "ok" and nodes.returncode == 0 and nodes.stdout.strip() == "True":
            return
        time.sleep(5)
    raise KuiqctlError("Kubernetes API and node did not become ready within 300 seconds")


def enable_agent() -> None:
    unit = pathlib.Path("/etc/systemd/system/kuiqctl-agent.service")
    if not unit.exists():
        raise KuiqctlError("agent unit is missing; run the repository install.sh first")
    run(["systemctl", "daemon-reload"])
    run(["systemctl", "enable", "--now", "kuiqctl-agent.service"])


def prepare_creation(cfg: dict) -> None:
    if not pathlib.Path("/run/systemd/system").exists():
        raise KuiqctlError("systemd is required")
    try:
        prepare_host(cfg)
        configure_firewall(cfg)
        write_kubeadm_config(cfg)
        prepare_creation_artifacts(cfg)
    except subprocess.CalledProcessError as exc:
        raise KuiqctlError(
            f"host preparation failed before cluster reset: command exited {exc.returncode}: "
            f"{' '.join(exc.cmd)}. Fix the reported package, service, DNS, or runtime error and retry; "
            "no existing cluster state was reset"
        ) from exc


def initialize_cluster(cfg: dict) -> None:
    version = installed_kubernetes_version()
    print(f"Creating kubeadm cluster {cfg['cluster_name']} with Kubernetes {version}...")
    try:
        result = run(
            ["kubeadm", "init", "--config", str(KUBEADM_CONFIG)],
            check=False,
            capture=True,
            timeout=600,
        )
    except subprocess.TimeoutExpired as exc:
        raise KuiqctlError(
            "kubeadm init exceeded 10 minutes. Inspect containerd and kubelet with "
            "'sudo journalctl -u containerd -u kubelet -n 200'; then retry with "
            "'sudo kuiqctl recreate --yes'"
        ) from exc
    if result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    if result.returncode != 0:
        output = result.stderr + "\n" + result.stdout
        lowered = output.lower()
        if "port-" in lowered or "port " in lowered and "in use" in lowered:
            hint = "stale or unrelated processes still own required ports"
        elif "imagepull" in lowered or "failed to pull" in lowered:
            hint = "registry availability changed after artifact preflight"
        elif "container runtime" in lowered or "cri" in lowered:
            hint = "containerd/CRI is unhealthy; inspect 'sudo journalctl -u containerd -n 200'"
        elif "swap" in lowered:
            hint = "swap was re-enabled; inspect 'swapon --show'"
        else:
            hint = "inspect 'sudo journalctl -u kubelet -n 200' and 'sudo crictl ps -a'"
        lines = [line.strip() for line in output.splitlines() if line.strip()]
        detail = lines[-1][:500] if lines else "kubeadm returned no error text"
        raise KuiqctlError(
            f"kubeadm initialization failed: {hint}. Last error: {detail}. "
            "Partial state may exist; correct the cause and run 'sudo kuiqctl recreate --yes'"
        )
    install_calico(cfg)
    wait_ready()
    enable_agent()
    try:
        destination = install_default_kubeconfig(cfg)
    except (KuiqctlError, OSError) as exc:
        print(
            f"Warning: cluster is ready, but could not configure kubectl for the invoking user: {exc}. "
            "Run 'sudo kuiqctl kubeconfig --output \"$HOME/.kube/kuiqctl.yaml\"' manually.",
            file=sys.stderr,
        )
        destination = None
    print(f"Cluster is ready at https://{cfg['endpoint']}:6443")
    if destination:
        print(f"kubectl is configured via {destination}; check the node with: kubectl get nodes")


def create(cfg: dict) -> None:
    require_root()
    with lifecycle_lock():
        clean_host_preflight()
        prepare_creation(cfg)
        initialize_cluster(cfg)


def reset_cluster(cfg: dict, *, remove_alias: bool) -> None:
    run(["systemctl", "disable", "--now", "kuiqctl-agent.service"], check=False)
    run(["systemctl", "stop", "kubelet"], check=False)
    if legacy_k3s_present():
        legacy_uninstaller = pathlib.Path("/usr/local/bin/k3s-uninstall.sh")
        if not legacy_uninstaller.exists():
            raise KuiqctlError("legacy K3s state exists but k3s-uninstall.sh is missing")
        run([str(legacy_uninstaller)])
    stale_ports = occupied_control_plane_ports()
    if shutil.which("kubeadm") and (cluster_present() or stale_ports):
        # A previous cluster may have used CRI-O while the new default is
        # containerd. Reset every live CRI so old static Pods cannot retain
        # scheduler/controller/etcd ports after the filesystem was cleaned.
        for cri_socket in available_cri_sockets():
            run(
                ["kubeadm", "reset", "--force", "--cri-socket", cri_socket],
                check=False,
            )
            remove_remaining_cri_workloads(cri_socket)
    stop_stale_control_plane_processes()
    for path in [pathlib.Path("/etc/cni/net.d/10-calico.conflist"), pathlib.Path("/etc/cni/net.d/calico-kubeconfig")]:
        path.unlink(missing_ok=True)
    for interface in ["cni0", "tunl0", "vxlan.calico"]:
        run(["ip", "link", "delete", interface], check=False, capture=True)
    wait_for_control_plane_ports()
    if remove_alias:
        run(["ip", "address", "delete", f"{cfg['stable_node_ip']}/32", "dev", "lo"], check=False, capture=True)
        run(["systemctl", "disable", "--now", "kubelet"], check=False)


def remove(cfg: dict, yes: bool) -> None:
    require_root()
    if not yes:
        raise KuiqctlError("remove destroys workloads and cluster data; repeat with --yes")
    with lifecycle_lock():
        reset_cluster(cfg, remove_alias=True)
        print("Cluster and kubeadm state removed; packages and kuiqctl configuration were preserved.")


def recreate(cfg: dict, yes: bool) -> None:
    require_root()
    if not yes:
        raise KuiqctlError("recreate destroys workloads and cluster data; repeat with --yes")
    with lifecycle_lock():
        # Resolve and locally cache every external dependency before deleting a
        # working cluster. Network, DNS, mirror, or auth failures stop here.
        prepare_creation(cfg)
        reset_cluster(cfg, remove_alias=False)
        clean_host_preflight()
        initialize_cluster(cfg)


def rewrite_kubeconfig(text: str, endpoint: str, cluster_name: str) -> str:
    text = re.sub(r"https://[^:\s]+:6443", f"https://{endpoint}:6443", text, count=1)
    text = re.sub(
        r"(?m)^(\s*(?:name|cluster|user|current-context):\s*)kubernetes(?:-admin)?(\s*)$",
        rf"\g<1>{cluster_name}\g<2>",
        text,
    )
    return text


def invoking_user() -> tuple[str, pathlib.Path, int, int]:
    raw_uid = os.environ.get("SUDO_UID")
    try:
        uid = int(raw_uid) if raw_uid is not None else os.getuid()
        account = pwd.getpwuid(uid)
    except (KeyError, TypeError, ValueError) as exc:
        raise KuiqctlError("could not identify the user who invoked sudo") from exc
    return account.pw_name, pathlib.Path(account.pw_dir), uid, account.pw_gid


def write_user_file(destination: pathlib.Path, content: str, uid: int, gid: int) -> None:
    parent_existed = destination.parent.exists()
    destination.parent.mkdir(parents=True, exist_ok=True)
    if not parent_existed:
        os.chmod(destination.parent, 0o700)
        os.chown(destination.parent, uid, gid)
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            prefix=f".{destination.name}.",
            dir=destination.parent,
            delete=False,
        ) as handle:
            handle.write(content)
            temporary = pathlib.Path(handle.name)
        os.chmod(temporary, 0o600)
        os.chown(temporary, uid, gid)
        temporary.replace(destination)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def install_default_kubeconfig(cfg: dict) -> pathlib.Path:
    if not ADMIN_CONF.exists():
        raise KuiqctlError("cluster kubeconfig does not exist")
    username, home, uid, gid = invoking_user()
    destination = home / ".kube" / "config"
    content = rewrite_kubeconfig(ADMIN_CONF.read_text(), cfg["endpoint"], cfg["cluster_name"])
    if destination.exists():
        source = None
        try:
            with tempfile.NamedTemporaryFile(mode="w", prefix="kuiqctl-kubeconfig-", delete=False) as handle:
                handle.write(content)
                source = pathlib.Path(handle.name)
            os.chmod(source, 0o600)
            env = os.environ.copy()
            env["KUBECONFIG"] = f"{source}{os.pathsep}{destination}"
            content = run(
                ["kubectl", "config", "view", "--flatten", "--raw"],
                capture=True,
                env=env,
            ).stdout
        finally:
            if source is not None:
                source.unlink(missing_ok=True)
    write_user_file(destination, content, uid, gid)
    print(f"Configured kubectl for {username} at {destination}")
    return destination


def kubeconfig(cfg: dict, output: str | None) -> None:
    require_root()
    if not ADMIN_CONF.exists():
        raise KuiqctlError("cluster kubeconfig does not exist; create the cluster first")
    content = rewrite_kubeconfig(ADMIN_CONF.read_text(), cfg["endpoint"], cfg["cluster_name"])
    if not output or output == "-":
        sys.stdout.write(content)
        return
    destination = pathlib.Path(output).expanduser()
    sudo_uid, sudo_gid = os.environ.get("SUDO_UID"), os.environ.get("SUDO_GID")
    uid = int(sudo_uid) if sudo_uid else os.getuid()
    gid = int(sudo_gid) if sudo_gid else os.getgid()
    write_user_file(destination, content, uid, gid)
    print(f"Wrote {destination}")


def primary_ip() -> str:
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        sock.connect(("1.1.1.1", 53))
        return sock.getsockname()[0]
    except OSError:
        return ""
    finally:
        if "sock" in locals():
            sock.close()


def stable_ip_on_loopback(address: str) -> bool:
    result = run(["ip", "-4", "-o", "address", "show", "dev", "lo"], check=False, capture=True)
    if result.returncode != 0:
        return False
    return any(
        match.group(1) == address
        for match in re.finditer(r"\binet\s+([0-9.]+)/[0-9]+", result.stdout)
    )


def resolve_ipv4(host: str) -> list[str]:
    return sorted(
        {
            item[4][0]
            for item in socket.getaddrinfo(host, 6443, family=socket.AF_INET, type=socket.SOCK_STREAM)
        }
    )


def tcp_port_open(host: str, port: int, timeout: float = 3.0) -> bool:
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def node_health(payload: str, stable_ip: str) -> tuple[str, bool, list[str]]:
    data = json.loads(payload)
    items = data.get("items")
    if not isinstance(items, list) or not items:
        raise ValueError("Kubernetes returned no nodes")
    node = next(
        (
            item
            for item in items
            if stable_ip
            in [
                address.get("address")
                for address in item.get("status", {}).get("addresses", [])
                if address.get("type") == "InternalIP"
            ]
        ),
        items[0],
    )
    name = node.get("metadata", {}).get("name") or "unknown"
    conditions = node.get("status", {}).get("conditions", [])
    ready = any(
        condition.get("type") == "Ready" and condition.get("status") == "True"
        for condition in conditions
    )
    internal_ips = [
        address.get("address")
        for address in node.get("status", {}).get("addresses", [])
        if address.get("type") == "InternalIP" and address.get("address")
    ]
    return name, ready, internal_ips


def calico_health(payload: str) -> tuple[bool, str]:
    data = json.loads(payload)
    status_data = data.get("status", {})
    desired = status_data.get("desiredNumberScheduled", 0)
    ready = status_data.get("numberReady", 0)
    unavailable = status_data.get("numberUnavailable", 0)
    healthy = isinstance(desired, int) and desired > 0 and ready == desired and unavailable in {0, None}
    return healthy, f"{ready}/{desired} calico-node pods Ready"


def doctor(config_path: pathlib.Path) -> int:
    require_root()
    print("kuiqctl doctor\n")
    failures = 0
    warnings = 0

    def report(level: str, label: str, detail: str = "", action: str = "") -> None:
        nonlocal failures, warnings
        if level == "FAIL":
            failures += 1
        elif level == "WARN":
            warnings += 1
        suffix = f"  {detail}" if detail else ""
        print(f"[{level}] {label:<22}{suffix}")
        if action:
            print(f"       Action: {action}")

    if not path_exists(config_path):
        report(
            "FAIL",
            "config",
            f"{config_path} is missing",
            "reinstall kuiqctl or run 'sudo kuiqctl init' with the intended --config path",
        )
        print("\nCluster unhealthy: configuration is unavailable.")
        return 1
    try:
        cfg = load_config(config_path)
    except KuiqctlError as exc:
        report("FAIL", "config", str(exc), f"correct {config_path} and rerun doctor")
        print("\nCluster unhealthy: configuration is invalid.")
        return 1
    report("OK", "config", str(config_path))

    services = (
        ("containerd", "containerd", "sudo systemctl restart containerd; sudo journalctl -u containerd -n 100"),
        ("kubelet", "kubelet", "sudo systemctl restart kubelet; sudo journalctl -u kubelet -n 100"),
        (
            "kuiqctl-agent.service",
            "network watcher",
            "sudo systemctl restart kuiqctl-agent.service; sudo journalctl -u kuiqctl-agent.service -n 100",
        ),
    )
    for unit, label, action in services:
        if service_active(unit):
            report("OK", label, "running")
        else:
            report("FAIL", label, "not running", action)

    stable_ip = cfg["stable_node_ip"]
    if stable_ip_on_loopback(stable_ip):
        report("OK", "stable node IP", stable_ip)
    else:
        report(
            "FAIL",
            "stable node IP",
            f"{stable_ip} is missing from loopback",
            "sudo systemctl restart kuiqctl-agent.service",
        )

    lan_ip = primary_ip()
    if lan_ip:
        report("OK", "current LAN IP", lan_ip)
    else:
        report(
            "FAIL",
            "current LAN IP",
            "no default-route IPv4 address found",
            "reconnect the LAN/VPN and inspect 'ip -4 route'",
        )

    endpoint = cfg["endpoint"]
    endpoint_addresses: list[str] = []
    try:
        endpoint_addresses = resolve_ipv4(endpoint)
    except OSError:
        endpoint_addresses = []
    if endpoint_addresses:
        mapping = f"{endpoint} -> {', '.join(endpoint_addresses)}"
        if lan_ip and lan_ip not in endpoint_addresses:
            report(
                "WARN",
                "endpoint",
                f"{mapping}; current LAN IP is {lan_ip}",
                "restart avahi-daemon or update the endpoint's DNS record",
            )
        else:
            report("OK", "endpoint", mapping)
        if tcp_port_open(endpoint, 6443):
            report("OK", "endpoint port", f"{endpoint}:6443 reachable")
        else:
            report(
                "FAIL",
                "endpoint port",
                f"{endpoint}:6443 is not reachable",
                "check kube-apiserver, host firewall, and allowed_client_cidrs",
            )
    elif endpoint.lower().endswith(".local"):
        report(
            "WARN",
            "endpoint",
            f"{endpoint} does not resolve through mDNS",
            f"sudo systemctl restart avahi-daemon; resolvectl query {endpoint}",
        )
    else:
        report(
            "FAIL",
            "endpoint",
            f"{endpoint} does not resolve",
            "repair the configured DNS record or change endpoint in the kuiqctl config",
        )

    if tcp_port_open(stable_ip, 6443):
        report("OK", "control-plane port", f"{stable_ip}:6443 reachable")
    else:
        report(
            "FAIL",
            "control-plane port",
            f"{stable_ip}:6443 is not reachable",
            "inspect 'sudo journalctl -u kubelet -n 100' and kube-apiserver containers",
        )

    kubeconfig_ready = path_exists(ADMIN_CONF)
    if kubeconfig_ready:
        report("OK", "admin kubeconfig", str(ADMIN_CONF))
    else:
        report(
            "FAIL",
            "admin kubeconfig",
            f"{ADMIN_CONF} is missing",
            "if the cluster was removed, run 'sudo kuiqctl create'; otherwise inspect /etc/kubernetes",
        )

    kubectl_ready = bool(shutil.which("kubectl")) and kubeconfig_ready
    if kubectl_ready:
        try:
            api = kubectl(["get", "--raw=/readyz"], check=False, capture=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            api = None
        if api is not None and api.returncode == 0 and api.stdout.strip() == "ok":
            report("OK", "Kubernetes API", "/readyz returned ok")
        else:
            report(
                "FAIL",
                "Kubernetes API",
                "/readyz did not return ok",
                "sudo journalctl -u kubelet -n 100; sudo crictl ps -a",
            )

        try:
            nodes = kubectl(["get", "nodes", "-o", "json"], check=False, capture=True, timeout=10)
            if nodes.returncode != 0:
                raise ValueError(nodes.stderr.strip() or "kubectl get nodes failed")
            node_name, ready, internal_ips = node_health(nodes.stdout, stable_ip)
            if ready:
                report("OK", "node Ready", node_name)
            else:
                report(
                    "FAIL",
                    "node Ready",
                    f"{node_name} is not Ready",
                    f"kubectl describe node {node_name}; sudo journalctl -u kubelet -n 100",
                )
            if stable_ip in internal_ips:
                report("OK", "node InternalIP", stable_ip)
            else:
                shown = ", ".join(internal_ips) or "none"
                report(
                    "FAIL",
                    "node InternalIP",
                    f"expected {stable_ip}; found {shown}",
                    "check kubelet node-ip configuration and restart kubelet",
                )
        except (OSError, subprocess.TimeoutExpired, ValueError, json.JSONDecodeError) as exc:
            report(
                "FAIL",
                "node status",
                str(exc),
                "kubectl get nodes -o wide; sudo journalctl -u kubelet -n 100",
            )

        try:
            calico = kubectl(
                ["-n", "kube-system", "get", "daemonset", "calico-node", "-o", "json"],
                check=False,
                capture=True,
                timeout=10,
            )
            if calico.returncode != 0:
                raise ValueError(calico.stderr.strip() or "calico-node daemonset was not found")
            healthy, detail = calico_health(calico.stdout)
            if healthy:
                report("OK", "Calico", detail)
            else:
                report(
                    "FAIL",
                    "Calico",
                    detail,
                    "kubectl -n kube-system get pods -l k8s-app=calico-node -o wide",
                )
        except (OSError, subprocess.TimeoutExpired, ValueError, json.JSONDecodeError) as exc:
            report(
                "FAIL",
                "Calico",
                str(exc),
                "kubectl -n kube-system get daemonset,pods -l k8s-app=calico-node -o wide",
            )
    else:
        reason = "kubectl is missing" if not shutil.which("kubectl") else "admin kubeconfig is missing"
        for label, action in (
            ("Kubernetes API", "install kubectl and restore /etc/kubernetes/admin.conf"),
            ("node status", "restore API access, then run 'kubectl get nodes -o wide'"),
            ("Calico", "restore API access, then inspect the calico-node daemonset"),
        ):
            report("FAIL", label, f"check skipped: {reason}", action)

    if failures:
        print(f"\nCluster unhealthy: {failures} important check(s) failed and {warnings} warning(s) reported.")
        return 1
    if warnings:
        print(f"\nCluster healthy, with {warnings} warning(s).")
    else:
        print("\nCluster healthy.")
    return 0


def status(cfg: dict) -> int:
    kubelet = service_active("kubelet")
    watcher = service_active("kuiqctl-agent.service")
    legacy = legacy_k3s_present()
    print(f"cluster:  {cfg['cluster_name']}")
    print("backend:  kubeadm")
    print(f"kubelet:  {'running' if kubelet else 'stopped'}")
    print(f"watcher:  {'running' if watcher else 'stopped'}")
    print(f"endpoint: https://{cfg['endpoint']}:6443")
    print(f"host-ip:  {primary_ip() or 'unavailable'}")
    print(f"node-ip:  {cfg['stable_node_ip']} (host-only, stable)")
    occupied = occupied_control_plane_ports()
    if occupied:
        print(f"ports:    occupied control-plane ports: {', '.join(map(str, occupied))}")
    if legacy:
        print("legacy:   K3s state detected; use kuiqctl recreate --yes to migrate")
    if path_exists(ADMIN_CONF) and os.geteuid() == 0:
        return kubectl(["get", "nodes", "-o", "wide"], check=False).returncode
    return 1 if cluster_present() or legacy or occupied else 0


def preflight(cfg: dict) -> None:
    clean_host_preflight()
    resolve_required_hosts(cfg)
    print("Preflight passed: host is clean and required registry/manifest DNS names resolve.")
    print(f"DNS nameserver(s): {configured_nameservers()}")
    print(f"Planned cluster: {cfg['cluster_name']} (Kubernetes {cfg['kubernetes_minor']})")
    print(f"Roaming endpoint: https://{cfg['endpoint']}:6443")


def agent(cfg: dict, once: bool) -> None:
    require_root()
    IP_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    previous = IP_STATE_PATH.read_text().strip() if IP_STATE_PATH.exists() else ""
    while True:
        run(["swapoff", "-a"])
        ensure_stable_ip(cfg)
        current = primary_ip()
        if current and current != previous:
            IP_STATE_PATH.write_text(current + "\n")
            print(f"primary LAN IP is now {current}; stable kubeadm node IP remains {cfg['stable_node_ip']}", flush=True)
            previous = current
        if once:
            return
        time.sleep(cfg["network_poll_seconds"])


def init_config(path: pathlib.Path) -> None:
    require_root()
    if path.exists():
        raise KuiqctlError(f"refusing to overwrite existing {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(defaults(), indent=2) + "\n")
    os.chmod(path, 0o644)
    print(f"Created {path}; endpoint defaults to this-hostname.local when left empty.")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="kuiqctl", description=__doc__)
    root.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    root.add_argument("--config", type=pathlib.Path, default=CONFIG_PATH)
    root.add_argument(
        "--yes",
        action="store_true",
        help="confirm a destructive recreate or remove operation",
    )
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("create", help="create and start a kubeadm cluster")
    destructive = commands.add_parser("recreate", help="destroy and create the cluster")
    destructive.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    delete = commands.add_parser("remove", help="destroy and remove the cluster")
    delete.add_argument("--yes", action="store_true", default=argparse.SUPPRESS)
    commands.add_parser("status", help="show cluster and network status")
    commands.add_parser("preflight", help="verify that create can start on this host")
    commands.add_parser("doctor", help="diagnose an existing cluster")
    export = commands.add_parser("kubeconfig", help="export a roaming kubeconfig")
    export.add_argument("--output", "-o")
    internal = commands.add_parser("agent", help=argparse.SUPPRESS)
    internal.add_argument("--once", action="store_true", help=argparse.SUPPRESS)
    commands.add_parser("init", help="create a default configuration")
    return root


def main(argv=None) -> int:
    argument_parser = parser()
    args = argument_parser.parse_args(argv)
    if args.yes and args.command not in {"recreate", "remove"}:
        argument_parser.error("--yes is only valid with recreate or remove")
    try:
        if args.command in {"create", "recreate", "remove", "kubeconfig", "agent", "init", "preflight", "doctor"}:
            require_root()
        if args.command == "init":
            init_config(args.config)
            return 0
        if args.command == "doctor":
            return doctor(args.config)
        cfg = load_config(args.config)
        if args.command == "create":
            create(cfg)
        elif args.command == "recreate":
            recreate(cfg, args.yes)
        elif args.command == "remove":
            remove(cfg, args.yes)
        elif args.command == "status":
            return status(cfg)
        elif args.command == "preflight":
            preflight(cfg)
        elif args.command == "kubeconfig":
            kubeconfig(cfg, args.output)
        elif args.command == "agent":
            agent(cfg, args.once)
        return 0
    except KuiqctlError as exc:
        print(f"kuiqctl: {exc}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as exc:
        print(f"kuiqctl: command failed ({exc.returncode}): {' '.join(exc.cmd)}", file=sys.stderr)
        return exc.returncode or 1


if __name__ == "__main__":
    raise SystemExit(main())
